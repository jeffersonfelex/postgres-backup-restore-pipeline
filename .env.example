# Copie para .env e preencha. O .env nunca é versionado (.gitignore).

# Conexão SSH/SFTP com o servidor onde estão os backups
host=
port=22
usuario=
senha=

# Diretórios
local_dir=          # pasta local onde os arquivos serão salvos
remote_dir=         # pasta remota com os backups (*_PROD.zip)

# Bases a processar: palavra-chave no nome do arquivo remoto (vira a subpasta local
# e o sufixo do banco restaurado: <db_prefixo><BASE>, ex.: RESTORE_NORTE)
bases=NORTE,SUL,CENTRO
db_prefixo=RESTORE_

# PostgreSQL de destino
db_host=
db_port=5432
db_user=
db_pass=
pg_restore_path=    # caminho completo do executável pg_restore
db_controle=PIPELINE_CONTROLE   # banco de controle do modo agendado (criado automaticamente)

# Opcional: webhook (Workflows) do Teams para o resumo das execuções agendadas
teams_webhook_url=
